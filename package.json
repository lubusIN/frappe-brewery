{
  "name": "frappe-app-registry",
  "version": "0.1.0",
  "description": "Community-maintained app index for the Frappe ecosystem",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run registry:build && vite build && cp -r index dist/index && cp -r apps dist/apps",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "registry:build": "tsx scripts/generate-index.ts",
    "registry:extract": "tsx scripts/extract.ts",
    "registry:validate": "tsx scripts/validate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.5.0",
    "frappe-ui": "^0.1.278",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.1",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
